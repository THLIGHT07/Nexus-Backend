# Copy to .env (never commit .env) and fill in.

PORT=5000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Railway: add the Postgres plugin and reference its URL in your backend service's Variables, e.g.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally: postgresql://USER:PASSWORD@localhost:5432/nexus
# Tables are created / updated automatically on startup (see migrations/).
DATABASE_URL=postgresql://user:password@localhost:5432/nexus
# Set to true ONLY when connecting through Railway's PUBLIC proxy URL (e.g. running the import script from your
# own computer). The private *.railway.internal URL does not need it.
#DATABASE_SSL=true
#DATABASE_POOL_MAX=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: the exact address(es) of your frontend, comma-separated. Unset = any origin is allowed.
#CORS_ORIGIN=https://your-frontend.example.com

# Secret used to sign user login tokens. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Admin panel protection ───────────────────────────────────────────────────
# Recommended: a bcrypt hash. Create it with   npm run set-admin-password
# (it writes this line for you). Keep the single quotes — the hash contains $ signs.
ADMIN_PASSWORD_HASH='$2b$12$replace-this-using-npm-run-set-admin-password'

# Alternative (less safe — plain text in a file): leave ADMIN_PASSWORD_HASH out and use
#   ADMIN_PASSWORD=a-long-password-at-least-8-chars
# If neither is set the admin API stays DISABLED (it never runs open).

# How long an admin sign-in lasts (examples: 30m, 2h, 1d). Default 2h.
#ADMIN_TOKEN_TTL=2h

# Only if the server sits behind a reverse proxy (nginx, Cloudflare…): number of proxy
# hops, so the login / code / admin lockouts see each visitor's real IP. Leave unset otherwise.
# ON RAILWAY SET THIS TO 1 — without it every visitor looks like the same IP and the per-IP limits
# (login lockout, 5 code requests/hour) would be shared by ALL users.
#TRUST_PROXY=1

# ── Email codes (forgot password / change password / verify email) via Brevo ─
# Free tier is plenty: sign up at brevo.com -> SMTP & API -> API Keys, and add + verify your
# sender address under Senders & IP. Keep the real values ONLY in your .env (never commit it).
# With these unset (and NODE_ENV not "production") codes are printed in the server console instead.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=no-reply@your-domain.com
#BREVO_FROM_NAME=Nexus Storage

# Optional tuning (defaults shown)
#OTP_TTL_MINUTES=10          # how long a code works
#OTP_COOLDOWN_SECONDS=60     # minimum gap between code requests
#OTP_MAX_PER_HOUR=5          # code requests per hour, per account and per IP
#OTP_SECRET=                 # key used to hash codes; falls back to JWT_SECRET
